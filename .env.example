# ============================================================================
# 基础配置模板（所有环境共享）—— 复制为 .env 后按需修改
#   开发：cp .env.example .env && cp .env.dev.example .env.dev
#   生产：cp .env.example .env && cp .env.prod.example .env.prod
#
# 加载优先级：进程环境变量 > .env.<APP_ENV> > .env > 代码默认值
# 本文件只放非敏感默认值；密码等敏感信息只写在 .env / 环境变量里，且不要提交到仓库
# ============================================================================

# 运行环境：dev（默认）/ prod。生产必须显式设为 prod，否则会按开发配置运行
APP_ENV=dev

# MySQL 连接串（敏感）。
# 密码里的特殊字符必须做 URL 编码：@ -> %40、/ -> %2F、# -> %23、% -> %25
# 例如密码 p@ss/word 写作：mysql+pymysql://app:p%40ss%2Fword@127.0.0.1:3306/user_api?charset=utf8mb4
# 无需手动解码，SQLAlchemy 解析连接串时会自动还原
MYSQL_URL={{mysql_url}}

# JWT：签名密钥必须通过环境变量 / .env 提供，代码里不写死
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 未配置或长度 < 32 会直接启动失败
JWT_SECRET_KEY={{jwt_secret_key}}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# 日志：级别 DEBUG/INFO/WARNING/ERROR，文件按大小轮转
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
LOG_ACCESS=true

# 注册接口限流：固定窗口 + IP 维度
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# 文件上传：单文件大小上限（默认 10MB）
# STORAGE_ROOT 只服务于旧的本地落盘实现（app/services/upload_service.py，教学用，不参与运行）
MAX_UPLOAD_BYTES=10485760
STORAGE_ROOT=storage

# SeaweedFS 对象存储（S3 网关）：MySQL 只存元数据，原文件放这里
# 网关地址形如 http://127.0.0.1:8333；Access/Secret Key 为敏感信息，生产请走环境变量 / 密钥管理服务
SEAWEEDFS_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_ACCESS_KEY={{seaweedfs_access_key}}
SEAWEEDFS_SECRET_KEY={{seaweedfs_secret_key}}
# 默认 bucket（需先在 SeaweedFS 上创建，如 `weed shell` -> `s3.bucket.create -name test`）
SEAWEEDFS_BUCKET=test
# S3 签名区域（SeaweedFS 不校验，占位即可）
SEAWEEDFS_REGION=us-east-1
# 对外访问地址：CDN / 反向代理前缀，如 https://cdn.example.com；留空则用 <endpoint>/<bucket>
SEAWEEDFS_PUBLIC_BASE_URL=
# 配了 Access/Secret Key（开启鉴权）时用预签名 URL 给前端访问，有效期（秒）
SEAWEEDFS_PRESIGN_EXPIRE_SECONDS=3600

# 资源过期时间：storage_scene=0 长过期（默认 1 个月），=1 短过期（默认 2 小时）
RESOURCE_TTL_LONG_SECONDS=2592000
RESOURCE_TTL_SHORT_SECONDS=7200
# 过期清理时间：每天 03:00 扫描 resources.expire_time（先删对象，再删元数据）
RESOURCE_CLEANUP_HOUR=3
RESOURCE_CLEANUP_MINUTE=0

# ----------------------------------------------------------------------------
# LLM：流式聊天（POST /sessions/{session_id}/stream-chat）用的模型
# 代码只认这一组配置（模型层 app/llm/llm.py），默认 DeepSeek（OpenAI 兼容协议）
# 可选 provider：deepseek / openai / dashscope / moonshot / zhipu / ollama（本地无需 Key）
# 没配置 Key 时聊天接口返回 500 LLM_NOT_CONFIGURED，其它功能不受影响
# ----------------------------------------------------------------------------
LLM_PROVIDER=deepseek
# 留空则用该 provider 的默认模型（DeepSeek => deepseek-chat），也可只换模型不换 provider
LLM_MODEL=
# 敏感信息：只写在 .env / 环境变量里，不要提交仓库；也可用 provider 专属变量（如 DEEPSEEK_API_KEY）
LLM_API_KEY={{llm_api_key}}
# 留空则用 provider 默认地址（自建 / 代理网关时填）
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
# 记忆层注入的历史轮数上限
LLM_HISTORY_TURNS=10

# ----------------------------------------------------------------------------
# Redis：提示词模板缓存（Hash，key 默认 prompt:templates:active）
# 不可用时自动回退数据库读取，功能不受影响；REDIS_URL 配置后优先于 host/port/db
# ----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD={{redis_password}}
REDIS_URL=
# 生效模板的缓存 Key 与过期秒数（0 表示不过期）
PROMPT_CACHE_KEY=prompt:templates:active
PROMPT_CACHE_TTL=3600
# 启动时后台预热模板缓存；测试环境置 false，避免连真实数据库 / Redis
PROMPT_CACHE_WARMUP=true

# 数据库
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
# 建连超时（秒）：数据库不可达时快速失败，健康检查不会被拖住
DB_CONNECT_TIMEOUT=5
