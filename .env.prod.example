# 生产环境覆盖项（复制为 .env.prod）
# 生产必须显式配置连接串，缺失会直接启动失败（不允许带占位符上线）
APP_ENV=prod

# 真实连接串建议通过环境变量 / 密钥管理服务注入，不要提交到仓库
MYSQL_URL=mysql+pymysql://app:CHANGE_ME@mysql.internal:3306/user_api?charset=utf8mb4

# JWT 签名密钥：生产必须换成独立强密钥（>= 32 字符），建议由密钥管理服务注入；
# 这里的 CHANGE_ME 长度不足，未替换会直接启动失败
JWT_SECRET_KEY=CHANGE_ME

# 生产关闭接口文档，避免暴露内部接口清单
DOCS_ENABLED=false

# 生产只记 INFO 及以上，避免日志噪音；文件日志用于留痕与排障
LOG_LEVEL=INFO
DB_ECHO=false
LOG_DIR=/var/log/user-api

# 流式聊天用的模型 Key 与 Redis 密码属敏感信息，生产走环境变量 / 密钥管理服务注入，
# 不要写进本文件；Redis 不可用时提示词模板自动回退数据库，聊天本身不会因此不可用
# LLM_API_KEY=<由密钥管理服务注入>
# REDIS_PASSWORD=<由密钥管理服务注入>
