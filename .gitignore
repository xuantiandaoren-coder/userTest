# ---- 环境变量 / 敏感配置：只保留 *.example 模板，真实配置一律不入库 ----
.env
.env.*
!.env.example
!.env.dev.example
!.env.prod.example

# ---- 日志：运行时产物，用于留痕但不入库 ----
logs/
*.log
*.log.*

# ---- 上传文件：运行时产物，按用户 ID 分目录存储 ----
storage/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# ---- 测试与工具缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# onnxruntime / huggingface-xet 在 import fastembed 时写的会话文件（qdrant-client 会间接导入）
:memory:.ses
*.ses

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
